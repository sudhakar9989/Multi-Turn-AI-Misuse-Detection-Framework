# SentinelLoop Environment Configuration Example
# Copy this file to .env and insert your real credentials:
# cp .env.example .env

# OpenRouter API Key for target & judge models (or use OPENAI_API_KEY)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Target model being evaluated and protected
TARGET_MODEL=openai/gpt-4o-mini

# Independent LLM safety auditor
JUDGE_MODEL=anthropic/claude-haiku-4.5
